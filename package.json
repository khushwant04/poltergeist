{
  "name": "poltergeist-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "test": "vitest run",
    "test:prop": "vitest run prop.test",
    "lint": "tsc -p tsconfig.json --noEmit && node scripts/lint.mjs",
    "poltergeist": "tsx packages/cli/src/bin.ts",
    "demo": "node packages/cli/dist/bin.js run --suite demo --agent reference",
    "ci:suite": "node packages/cli/dist/bin.js run --suite ci --quiet --junit poltergeist-junit.xml --min-score 90"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.11.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
